# =============================================================================
# SUBOP — Environment Variables Template
# Copy this file to .env and fill in your local values.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# --- PostgreSQL (primary data warehouse + platform metadata) ---
POSTGRES_DB=subop
POSTGRES_USER=subop
POSTGRES_PASSWORD=subop_dev          # Change for any shared environment

# --- MySQL (secondary connector target — M2 prototype, M6 expansion) ---
MYSQL_ROOT_PASSWORD=mysql_root_dev   # Change for any shared environment
MYSQL_DATABASE=subop
MYSQL_USER=subop_app
MYSQL_PASSWORD=mysql_dev             # Change for any shared environment

# --- MSSQL (third connector target — M4) ---
MSSQL_SA_PASSWORD=SubopDev123!  # Change for any shared environment; min 8 chars, upper+lower+digit+symbol

# --- Oracle (fourth connector target — M6W20T5) ---
ORACLE_PASSWORD=oracle_dev        
ORACLE_USERNAME=subop_app
ORACLE_DATABASE=FREEPDB1

# --- pgAdmin (database admin UI — http://localhost:5050) ---
PGADMIN_EMAIL=admin@subop.dev
PGADMIN_PASSWORD=admin_dev           # Change for any shared environment

# --- FastAPI backend (activated in M3) ---
API_SECRET_KEY=dev-secret-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true                       # Set to false in production / pilot

# --- Kafka (CDC and streaming ingestion) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CDC_EVENTS=subop-cdc-events
KAFKA_TOPIC_STREAM_INGEST=subop-stream-ingest

# --- Debezium CDC connector (activated in M7) ---
DEBEZIUM_CONNECTOR_NAME=subop-postgres-cdc
DEBEZIUM_DATABASE_HOSTNAME=postgres
DEBEZIUM_DATABASE_PORT=5432
DEBEZIUM_DATABASE_DBNAME=subop
# Debezium connects as the dedicated CDC role below, not the application user
# (M7W22T2). Values are literal: docker compose does not expand ${VAR}
# references inside a .env file.
DEBEZIUM_DATABASE_USER=subop_cdc
DEBEZIUM_DATABASE_PASSWORD=cdc_dev

SUBOP_CDC_USER=subop_cdc
SUBOP_CDC_PASSWORD=cdc_dev
SUBOP_CDC_SCHEMA=cdc_demo
SUBOP_CDC_PUBLICATION=subop_cdc_pub
SUBOP_CDC_SLOT=subop_cdc_slot

# --- Connection References (M6 — ETL Engine connector refs, activated in M6) ---
# Format: SUBOP_CONN_{REF_UPPER}='<JSON object>' — the value must be JSON,
# since connection_resolver.py parses it with json.loads(). Keep the single
# quotes so the shell and docker compose read the JSON literally.
#   db-kind   (postgresql, mysql, mssql, oracle):
#             {"host","port","database","username","password"}
#   file-kind (sqlite, csv, json): {"file_path"}
#   url-kind  (rest_api):          {"base_url"}
# connection_ref in pipeline DSL → env var name:
#   pg-main     → SUBOP_CONN_PG_MAIN
#   dw-main     → SUBOP_CONN_DW_MAIN
#   mysql-main  → SUBOP_CONN_MYSQL_MAIN
#   mssql-main  → SUBOP_CONN_MSSQL_MAIN
#   oracle-main → SUBOP_CONN_ORACLE_MAIN
#   demo-csv    → SUBOP_CONN_DEMO_CSV
#   demo-api    → SUBOP_CONN_DEMO_API
# Values below are for running the API on the host (localhost + host ports;
# Postgres is mapped to 5433). The subop-api container does not read these —
# its in-network values live in docker-compose.yml.
SUBOP_CONN_PG_MAIN='{"host":"localhost","port":5433,"database":"subop","username":"subop","password":"subop_dev"}'
SUBOP_CONN_DW_MAIN='{"host":"localhost","port":5433,"database":"subop","username":"subop","password":"subop_dev"}'
SUBOP_CONN_MYSQL_MAIN='{"host":"localhost","port":3306,"database":"subop","username":"subop_app","password":"mysql_dev"}'
SUBOP_CONN_MSSQL_MAIN='{"host":"localhost","port":1433,"database":"master","username":"sa","password":"SubopDev123!"}'
SUBOP_CONN_ORACLE_MAIN='{"host":"localhost","port":1521,"database":"FREEPDB1","username":"subop_app","password":"oracle_dev"}'
SUBOP_CONN_DEMO_CSV='{"file_path":"data/samples/demo.csv"}'
SUBOP_CONN_DEMO_API='{"base_url":"https://api.example.com"}'

# --- CORS Origins (M6W20T6) ---
SUBOP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- ETL Engine (activated in M5) ---
ETL_BATCH_SIZE=10000
ETL_MAX_WORKERS=4
ETL_LOG_LEVEL=INFO

# --- Data Quality Engine (activated in M10) ---
QUALITY_ALERT_EMAIL=team@subop.local
QUALITY_MIN_SCORE_THRESHOLD=0.80    # Alert when dataset score drops below this

# --- Security (activated in M11) ---
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60